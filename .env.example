# SpatialForge Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your system.

SPATIALFORGE_DATASET_ROOT=datasets
SPATIALFORGE_CAPTURE_CONFIG=configs/capture.yaml
SPATIALFORGE_RECONSTRUCTION_CONFIG=configs/reconstruction.yaml
SPATIALFORGE_CORS_ORIGINS=http://localhost:5173

# Model weights: path to Depth Anything V2 small ONNX
SPATIALFORGE_DEPTH_MODEL=models/depth_anything_v2_small.onnx

# COLMAP executable path or directory (optional if colmap is in system PATH)
# SPATIALFORGE_COLMAP_PATH=colmap
