# Model weights (Download per README instructions)
models/*
!models/.gitkeep

# Runtime logs
logs/*
!logs/.gitkeep

# Frontend build outputs and dependencies
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/.vite/

# Temporary and scratch files
scratch/
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
desktop.ini
