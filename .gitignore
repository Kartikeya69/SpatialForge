# Environments
.venv/
venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Local environment configuration & secrets
.env
.env.local
*.local.yaml

# Runtime datasets (User media and scene reconstructions)
datasets/*
